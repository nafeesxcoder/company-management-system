# =============================================================================
# Backend API environment
# Copy to .env and fill in real values. NEVER commit a filled-in .env.
# The process refuses to start if a required value is missing or too weak.
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database — MySQL 8
# Only this backend ever connects. The web and mobile clients have no DB access.
# For managed MySQL (RDS / Aiven / PlanetScale) append ?ssl=true
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://cms_user:CHANGE_ME@127.0.0.1:3306/company_management"
DATABASE_POOL_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Authentication
# Generate each secret separately:  openssl rand -base64 48
# They MUST differ from each other in production.
# -----------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=CHANGE_ME_minimum_32_characters_long_random_string
REFRESH_TOKEN_SECRET=CHANGE_ME_different_minimum_32_characters_random
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=cms-api
JWT_AUDIENCE=cms-clients

# AES-256-GCM key encrypting payment provider secrets at rest.
# Exactly 64 hex characters:  openssl rand -hex 32
# Rotating this makes existing stored provider secrets unreadable — re-enter them.
APP_ENCRYPTION_KEY=CHANGE_ME_64_hex_characters_0000000000000000000000000000000000

# -----------------------------------------------------------------------------
# HTTP
# WEB_ORIGIN is a comma-separated CORS allowlist. Production must be HTTPS.
# -----------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
# COOKIE_DOMAIN=.yourdomain.com
# Set true only when running behind a reverse proxy / load balancer,
# so client IPs in rate limits and audit logs are accurate.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Rate limiting
# The default store is per-process. Behind more than one instance, use a shared
# store (Redis) — see docs/deployment.md.
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# Money / locale defaults
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Payment providers
#
# These are fallbacks. Per-account secrets are stored ENCRYPTED in the database
# via the Payment Integrations screen, which is the preferred path.
#
# Automatic income tracking is NOT working until, for each provider, you have:
#   1. entered the credentials,
#   2. registered the webhook URL with the provider,
#   3. mapped provider products to projects,
#   4. seen a signed test event processed end to end.
# See docs/payment-integrations.md.
# -----------------------------------------------------------------------------
# STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_WEBHOOK_SECRET=...
# GOOGLE_PLAY_PUBSUB_VERIFICATION_TOKEN=...

# How old a provider webhook timestamp may be before it is rejected as a replay.
WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# API documentation — disable in production if the API is internet-facing.
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Seed script (development only)
# -----------------------------------------------------------------------------
# SEED_COMPANY_NAME="My Company"
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=
# SEED_PARTNER_EMAIL=partner@example.com
# SEED_PARTNER_PASSWORD=
# SEED_OWNER_SHARE=50
# SEED_PARTNER_SHARE=50
# SEED_DEMO=false
