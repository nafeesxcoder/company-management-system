# =============================================================================
# Web frontend environment
#
# ONLY browser-safe values belong here. Everything prefixed NEXT_PUBLIC_ is
# embedded in the JavaScript bundle and visible to anyone who opens devtools.
#
# NEVER put here: DATABASE_URL, JWT secrets, Stripe/Razorpay secret keys,
# APP_ENCRYPTION_KEY, or any other backend credential.
# =============================================================================

# Base URL of the Express API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Shown in the UI; cosmetic only.
NEXT_PUBLIC_APP_NAME="Company Management"
